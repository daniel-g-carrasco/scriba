msgstr "Trascrizione"

#: src/scriba/app/engines/ffmpeg.py
msgid "ffmpeg could not make the video with the subtitles."
msgstr "ffmpeg non è riuscito a fare il video con i sottotitoli."

#: src/scriba/app/engines/ffmpeg.py
#, python-brace-format
msgid "{program} is missing: Scriba needs it to read audio and video files."
msgstr "Manca {program}: a Scriba serve per leggere i file audio e video."

#: src/scriba/app/engines/ffmpeg.py
#, python-brace-format
msgid "{name} cannot be read as audio or video."
msgstr "{name} non si riesce a leggere come audio o video."

#: src/scriba/app/engines/ffmpeg.py
#, python-brace-format
msgid "ffmpeg could not read the sound of {name}."
msgstr "ffmpeg non è riuscito a leggere l'audio di {name}."

#: src/scriba/app/engines/onnx.py
msgid "The installed onnxruntime is too old for Scriba."
msgstr "L'onnxruntime installato è troppo vecchio per Scriba."

#: src/scriba/app/engines/onnx.py
msgid "The speech engine (onnxruntime) failed."
msgstr "Il motore del parlato (onnxruntime) non è riuscito."

#: src/scriba/app/engines/onnx.py
msgid "onnxruntime is missing: Scriba needs it to find speech and tell the voices apart."
msgstr "Manca onnxruntime: a Scriba serve per trovare il parlato e distinguere le voci."

#: src/scriba/app/engines/onnx.py
msgid "onnxruntime cannot be loaded."
msgstr "Non è stato possibile caricare onnxruntime."

#: src/scriba/app/engines/whisper.py
msgid "whisper-cli is missing: Scriba needs it to turn speech into text."
msgstr "Manca whisper-cli: a Scriba serve per passare dal parlato al testo."

#: src/scriba/app/engines/whisper.py
msgid "whisper-cli could not transcribe the audio."
msgstr "whisper-cli non è riuscito a trascrivere l'audio."

#: src/scriba/app/engines/whisper.py
msgid "whisper-cli could not be started."
msgstr "Non è stato possibile avviare whisper-cli."

#: src/scriba/app/engines/whisper.py
#, python-brace-format
msgid "The installed whisper-cli is too old for Scriba (it lacks {options})."
msgstr "Il whisper-cli installato è troppo vecchio per Scriba (gli manca {options})."

