#: src/scriba/data/markdown.py:93
#, python-brace-format
msgid "Speakers: {count} told apart automatically, with the names given by hand; the attributions are to be checked against the audio."
msgstr "Parlanti: {count}, riconoscimento automatico, con i nomi dati a mano; le attribuzioni vanno ricontrollate sull'audio."

#: src/scriba/data/markdown.py:97
#, python-brace-format
msgid "Speakers: {count} told apart automatically{engine}, anonymous labels in order of appearance; the names are to be matched by listening. The attributions are to be checked against the audio."
msgstr "Parlanti: {count}, riconoscimento automatico{engine}; etichette anonime in ordine di comparsa, i nomi vanno associati ascoltando. Le attribuzioni vanno ricontrollate sull'audio."

#: src/scriba/data/markdown.py:100
msgid "Automatic transcription: names, acronyms and numbers are to be checked against the audio."
msgstr "Trascrizione automatica: nomi, sigle e numeri vanno ricontrollati sull'audio."

#: src/scriba/data/markdown.py:102
msgid "Automatic transcription: who speaks is not told apart; names, acronyms and numbers are to be checked against the audio."
msgstr "Trascrizione automatica: chi parla non è distinto; nomi, sigle e numeri vanno ricontrollati sull'audio."

#: src/scriba/data/markdown.py:105
#, python-brace-format
msgid "Lines marked {mark} are doubtful (the engine heard no clear speech, was unsure of the words, wrote the same words over and over, or the voice was very faint): check them against the audio."
msgstr "Le righe segnate {mark} sono dubbie (il motore non ha sentito parlato chiaro, era incerto sulle parole, ha scritto le stesse parole più volte o la voce era molto debole): vanno ricontrollate sull'audio."

#: src/scriba/data/session.py:133
#, python-brace-format
msgid "This meeting was saved by a newer version of the app (format {found}; this one reads up to {known}): update the app to open it."
msgstr "Questa riunione è stata salvata da una versione più nuova dell'app (formato {found}; questa legge fino al {known}): aggiorna l'app per aprirla."

#: src/scriba/data/session.py:154
#, python-brace-format
msgid "The meeting file could not be read: {reason}"
msgstr "Non è stato possibile leggere il file della riunione: {reason}"

#: src/scriba/data/session.py:164
#, python-brace-format
msgid "The meeting file is damaged and cannot be opened: {name}"
msgstr "Il file della riunione è danneggiato e non si può aprire: {name}"

#: src/scriba/data/srt.py:118
msgid "This is not a subtitle file: there is text before the first time line."
msgstr "Questo non è un file di sottotitoli: c'è del testo prima della prima riga dei tempi."

#: src/scriba/data/srt.py:122
msgid "This is not a subtitle file: no time line was found."
msgstr "Questo non è un file di sottotitoli: non c'è nessuna riga dei tempi."

#: src/scriba/data/srt.py:144
msgid "The subtitle file is not in UTF-8, the only encoding read."
msgstr "Il file dei sottotitoli non è in UTF-8, l'unica codifica che si legge."

