msgstr "anche una copia del video con i sottotitoli dentro"

#: src/scriba/cli.py
msgid "the language spoken"
msgstr "la lingua parlata"

#: src/scriba/cli.py
msgid "turbo is fast, large is more precise and slower"
msgstr "turbo è veloce, large è più preciso e più lento"

#: src/scriba/cli.py
