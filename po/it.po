msgstr "Dal parlato al testo, veloce (whisper large-v3-turbo)"

#: src/scriba/app/models.py
msgid "Speech to text, precise and slower (whisper large-v3)"
msgstr "Dal parlato al testo, preciso e più lento (whisper large-v3)"

