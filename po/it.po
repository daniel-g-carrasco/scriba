#, python-brace-format
msgid "The download of {name} stopped at {done} of {total}: try again, it goes on from there."
msgstr "Il download di {name} si è fermato a {done} su {total}: riprova, riparte da lì."

#: src/scriba/app/models.py
#, python-brace-format
msgid "The address of {name} is not one of its publisher's: refused."
msgstr "L'indirizzo di {name} non è di chi lo pubblica: rifiutato."

#: src/scriba/app/models.py
#, python-brace-format
msgid "There is not enough room on the disk for {name}: it needs {needed}, {free} are free."
msgstr "Sul disco non c'è abbastanza spazio per {name}: servono {needed}, liberi {free}."

#: src/scriba/app/models.py
#, python-brace-format
msgid "The server answered in a way that cannot be read ({code})."
msgstr "Il server ha risposto in un modo che non si sa leggere ({code})."

#: src/scriba/app/models.py
#, python-brace-format
msgid "The download of {name} failed: the server answered {code}."
msgstr "Il download di {name} non è riuscito: il server ha risposto {code}."

#: src/scriba/app/models.py
#, python-brace-format
msgid "The file downloaded is not {name} as published (its checksum differs): thrown away."
msgstr "Il file scaricato non è {name} come pubblicato (l'impronta è diversa): scartato."

#: src/scriba/app/models.py
#, python-brace-format
msgid "The server sends more than {name} weighs ({size}): refused."
msgstr "Il server manda più di quanto pesa {name} ({size}): rifiutato."

#: src/scriba/app/engines/audio.py
msgid "The audio prepared for the engines cannot be read."
msgstr "L'audio preparato per i motori non si riesce a leggere."

