#!/usr/bin/python3
"""Launcher: runs from a source checkout (src/ next to bin/) or from an
installed copy (the Flatpak puts the package in /app/share/scriba)."""

import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
for candidate in (os.path.join(here, "..", "src"), "/app/share/scriba"):
    if os.path.isdir(os.path.join(candidate, "scriba")):
        sys.path.insert(0, os.path.abspath(candidate))
        break

from scriba.__main__ import main  # noqa: E402

sys.exit(main())
